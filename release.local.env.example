# Optional local selection used only when this Mac has multiple
# Developer ID Application identities. Copy to release.local.env; that file is
# ignored by Git. Obtain the fingerprint without copying the certificate name:
#
# security find-identity -v -p codesigning | \
# awk '/"Developer ID Application:/{ print $2 }'

DEVELOPER_ID_SHA1=0000000000000000000000000000000000000000

